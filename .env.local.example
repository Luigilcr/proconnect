# ============================================================
# ProConnect — Variables de Entorno
# ============================================================
# Copia este archivo como .env.local y rellena tus valores reales.
# NUNCA subas .env.local a Git — ya está en .gitignore.
# ============================================================

# --- Supabase (requerido para producción) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- URL pública de la aplicación ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Service Role Key (solo scripts server-side, NUNCA con NEXT_PUBLIC_) ---
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
